<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_mode_form" model="ir.ui.view">
        <field name="name">view.res.mode.form</field>
        <field name="model">res.mode</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="seat_capacity"/>
                            <field name="availability_status"/>
                        </group>
                        <group>
                            <field name="license_plate"/>
                            <field name="vehicle_type"/>
                            <field name="rental_price_per_day"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fleet_vehicle_list" model="ir.ui.view">
        <field name="name">view.fleet.vehicle.list</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rental_price_per_day"/>
                <field name="availability_status"/>
            </list>
        </field>
    </record>
    <record id="action_fleet_vehicle" model="ir.actions.act_window">
        <field name="name">Thông tin xe</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_res_partner"
              name="Thông tin"
              parent="menu_res_partner_root"
              action="action_res_partner"
              sequence="10"/>


</odoo>